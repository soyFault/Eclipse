  <!-- Snitch -->
  <string name="Eclipse.Role.Snitch">Snitch</string>
  <string name="Eclipse.Role.Snitch.IntroBlurb">Find the Impostors!</string>
  <string name="Eclipse.Role.Snitch.MedDescription">Rat out the Impostors upon completion of your tasks.</string>
  <string name="Eclipse.Role.Snitch.TabDescription">Complete all your tasks to discover the Impostors.</string>
  <string name="Eclipse.Role.Snitch.WikiDescription">The Snitch is a Crewmate Investigative role that can reveal the Impostors to themselves by finishing all their tasks. Upon completing all tasks, the Impostors will be revealed to the Snitch with an arrow and their red name. When few tasks remain, the Impostors are warned and see the Snitch.</string>
