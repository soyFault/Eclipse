  <!-- Officer -->
  <string name="Eclipse.Role.Officer">Officer</string>
  <string name="Eclipse.Role.Officer.IntroBlurb">Reload and shoot the [color=#FF0000FF]Killers[/color]</string>
  <string name="Eclipse.Role.Officer.MedDescription">Reload your gun's chamber.[nl]Shoot those who threaten the Crewmates.</string>
  <string name="Eclipse.Role.Officer.TabDescription">Load bullets strategically without wasting them.[nl]Loaded bullets older than 10s are reset next round.</string>
  <string name="Eclipse.Role.Officer.WikiDescription">The Officer is a Crewmate Killing role that can shoot players with limited ammo. They must load bullets, which only last one round unless they are added within 10 seconds.</string>
