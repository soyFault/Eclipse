  <!-- Officer -->
  <string name="Eclipse.Role.Officer">Oficial</string>
  <string name="Eclipse.Role.Officer.IntroBlurb">Recarga y dispara a los [color=#FF0000FF]Asesinos[/color]</string>
  <string name="Eclipse.Role.Officer.MedDescription">Recarga tu arma.[nl]Dispárale a los que amenazan a la Tripulación.</string>
  <string name="Eclipse.Role.Officer.TabDescription">Carga balas estratégicamente sin desperdiciarlas.[nl]Las balas cargadas hace más de[nl]10 s se reinician la siguiente ronda.</string>
  <string name="Eclipse.Role.Officer.WikiDescription">El Oficial es un Tripulante Asesino que puede disparar a otros jugadores con munición limitada. Debe cargar balas, las cuales solo duran una ronda, a menos que se carguen durante los últimos 10 segundos.</string>
  <string name="Eclipse.Role.Officer.TabWaitCount">Rondas restantes para volver a disparar: &lt;count&gt;</string>
