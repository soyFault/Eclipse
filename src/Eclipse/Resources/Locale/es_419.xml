  <!-- Sheriff -->
  <string name="Eclipse.Role.Sheriff">Sheriff</string>
  <string name="Eclipse.Button.SheriffShoot">Disparar</string>
  <string name="Eclipse.Role.Sheriff.IntroBlurb">Dispara a los culpables</string>
  <string name="Eclipse.Role.Sheriff.MedDescription">Dispara a los Impostores y a los Neutrales peligrosos, pero ten cuidado porque equivocarse tiene consecuencias.</string>
  <string name="Eclipse.Role.Sheriff.TabDescription">Dispara a los Impostores. Si le das a un inocente fallas y ya no puedes disparar.</string>
  <string name="Eclipse.Role.Sheriff.WikiDescription">El Sheriff es un Tripulante Asesino. Disparar a un Impostor lo mata. Disparar a un inocente es un fallo: muere el Sheriff, el objetivo, ambos o nadie (es un ajuste), y el Sheriff no puede volver a disparar. Los roles Neutrales pueden ser objetivos válidos según su tipo.</string>
  <string name="Eclipse.Role.Sheriff.MisfireFeedback">¡Fallaste el disparo!</string>
  <string name="Eclipse.Role.Sheriff.TabMisfired">Ya no puedes disparar.</string>
  <string name="Eclipse.Role.Sheriff.TabMisfireKillsSheriff">Un disparo fallido hará que te suicides.</string>
  <string name="Eclipse.Role.Sheriff.TabMisfireKillsTarget">Un disparo fallido matará a tu objetivo, pero perderás tu habilidad.</string>
  <string name="Eclipse.Role.Sheriff.TabMisfireKillsBoth">Un disparo fallido te mata a ti y a tu objetivo.</string>
  <string name="Eclipse.Role.Sheriff.TabMisfireKillsNobody">Un disparo fallido evitará que vuelvas a disparar.</string>
<!-- Opciones del Sheriff-->
