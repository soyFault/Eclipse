  <!-- Medic -->
  <string name="Eclipse.Role.Medic">Chamán</string>
  <string name="Eclipse.Role.Medic.IntroBlurb">Invoca para proteger a un tripulante.</string>
  <string name="Eclipse.Role.Medic.MedDescription">Protege a un jugador con un escudo. Los ataques contra él se detienen.</string>
  <string name="Eclipse.Role.Medic.TabDescription">Protege a un jugador con un escudo para que los ataques contra él se detengan.</string>
  <string name="Eclipse.Role.Medic.WikiDescription">El Chamán es un Tripulante Protector que otorga un escudo. Mientras dura, los ataques contra el jugador protegido se detienen: el atacante lo nota y se queda con un enfriamiento corto. El escudo termina cuando muere el protegido o el Chamán y, según los ajustes, cuando absorbe un ataque.</string>
  <string name="Eclipse.Role.Medic.TabProtecting">Estás protegiendo a &lt;player&gt;.</string>
  <string name="Eclipse.Role.Medic.AttackBlocked">¡El objetivo está protegido por un chamán!</string>
  <string name="Eclipse.Role.Medic.ShieldAbsorbed">¡Un escudo absorbió un ataque!</string>
  <string name="Eclipse.Modifier.MedicShield">Escudo de Chamán</string>
  <string name="Eclipse.Modifier.MedicShield.Description">El escudo de un Chamán te protege de los ataques.</string>
  <string name="Eclipse.Button.MedicShield">Escudo</string>
  <string name="Eclipse.Option.Medic.ShieldedKnows">El protegido sabe que tiene escudo</string>
  <string name="Eclipse.Option.Medic.WhoGetsNotification">A quién avisar de ataques</string>
