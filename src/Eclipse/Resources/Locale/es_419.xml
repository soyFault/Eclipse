  <string name="Eclipse.Role.Investigator">Investigador</string>
  <string name="Eclipse.Role.Investigator.IntroBlurb">Descubre a los malos siguiendo sus huellas</string>
  <string name="Eclipse.Role.Investigator.MedDescription">Averigua donde van los demás siguiendo sus pasos.</string>
